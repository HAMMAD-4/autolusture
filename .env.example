# ─── Database ───────────────────────────────────────────────
# Local XAMPP / MariaDB (development defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aussi_clean

# ─── Auth ────────────────────────────────────────────────────
# MUST be a long random string in production (session cookie signing)
# Generate one: openssl rand -base64 32
LOCAL_AUTH_SECRET=replace-with-a-long-random-local-secret

# ─── SSL (optional, for remote/cloud databases) ──────────────
# Set DATABASE_SSL=false to disable SSL for local dev without SSL.
# Leave unset (default) to auto-enable SSL when DB_HOST is not localhost.
# The bundled isrgrootx1.pem (ISRG Root X1 / Let's Encrypt) is used automatically.
# DATABASE_SSL=false
# DATABASE_CA_PATH=/absolute/path/to/custom-ca.pem   # override bundled cert if needed
